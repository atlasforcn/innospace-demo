# Copy this file to .env.local for local backend development.
# Never commit .env.local or any real API key.
OPENROUTER_API_KEY=replace_with_server_side_openrouter_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_GROK_KEY=replace_with_backup_openrouter_grok_key
OPENROUTER_GROK_MODEL=x-ai/grok-4.3
OPENAI_API_KEY=replace_with_server_side_openai_key
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_MAPS_API_KEY=replace_with_server_side_google_maps_key
