{
  "version": "0.1",
  "commands": [
    {
      "subsystem": "ADCS",
      "command": "SET_TARGET_POINTING",
      "description": "Move from nominal attitude to approved target-pointing geometry.",
      "required_parameters": ["target_ref", "slew_deg", "settle_s"],
      "operator_gate": false
    },
    {
      "subsystem": "ADCS",
      "command": "HOLD_POINTING",
      "description": "Maintain approved pointing geometry during the requested event window.",
      "required_parameters": ["duration_s"],
      "operator_gate": false
    },
    {
      "subsystem": "ADCS",
      "command": "RETURN_LVLH",
      "description": "Return to nominal LVLH or mission-defined recovery attitude.",
      "required_parameters": [],
      "operator_gate": false
    },
    {
      "subsystem": "PAYLOAD",
      "command": "POWER_ON_PAYLOAD",
      "description": "Enable an approved payload family for the selected mission mode.",
      "required_parameters": ["payload_family"],
      "operator_gate": false
    },
    {
      "subsystem": "PAYLOAD",
      "command": "POWER_OFF_PAYLOAD",
      "description": "Return the payload to a powered-down or standby state.",
      "required_parameters": ["payload_family"],
      "operator_gate": false
    },
    {
      "subsystem": "PAYLOAD",
      "command": "SELECT_PAYLOAD_MODE",
      "description": "Select an approved payload mode before acquisition.",
      "required_parameters": ["mode"],
      "operator_gate": false
    },
    {
      "subsystem": "PAYLOAD",
      "command": "TRIGGER_CAPTURE",
      "description": "Execute an approved image or measurement acquisition event.",
      "required_parameters": ["target_ref"],
      "operator_gate": false
    },
    {
      "subsystem": "COMMS_DATA",
      "command": "RESERVE_STORAGE",
      "description": "Reserve onboard storage for a task product before acquisition.",
      "required_parameters": ["megabytes"],
      "operator_gate": false
    },
    {
      "subsystem": "COMMS_DATA",
      "command": "QUEUE_DOWNLINK",
      "description": "Place a product into an approved downlink queue.",
      "required_parameters": ["product_ref"],
      "operator_gate": false
    },
    {
      "subsystem": "COMMS_DATA",
      "command": "REQUEST_CROSSLINK_RELAY",
      "description": "Request a relay or crosslink delivery path if supported by the mission architecture.",
      "required_parameters": ["peer_asset"],
      "operator_gate": true
    },
    {
      "subsystem": "MISSION_CONTROL",
      "command": "MARK_OPERATOR_REVIEW",
      "description": "Hold a plan for explicit operator confirmation before release.",
      "required_parameters": ["reason"],
      "operator_gate": true
    },
    {
      "subsystem": "PROPULSION",
      "command": "REQUEST_MANEUVER_REVIEW",
      "description": "Create a review item for a propulsion-related planning request; never auto-release propulsion.",
      "required_parameters": ["maneuver_reason"],
      "operator_gate": true
    }
  ]
}
