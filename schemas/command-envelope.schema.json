{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/command-envelope.schema.json",
  "title": "BoundedCommandEnvelope",
  "type": "object",
  "required": ["schema_version", "mission_id", "operator_gate", "commands"],
  "properties": {
    "schema_version": { "type": "string", "const": "bounded-command-envelope.v0.1" },
    "mission_id": { "type": "string" },
    "operator_gate": { "type": "boolean", "const": true },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dispatch_type", "subsystem", "command", "parameters", "requires_human_confirmation"],
        "properties": {
          "dispatch_type": {
            "type": "string",
            "enum": ["immediate", "time_tagged", "post_event", "recurring"]
          },
          "subsystem": {
            "type": "string",
            "enum": ["ADCS", "CAMERA", "DATA_GROUND", "MISSION_CONTROL", "PROPULSION"]
          },
          "command": {
            "type": "string",
            "enum": [
              "ADCS_SET_MODE",
              "ADCS_SLEW_TO_AOI",
              "ADCS_TRACK_TARGET",
              "ADCS_RETURN_LVLH",
              "CAMERA_POWER_ON",
              "CAMERA_CONFIGURE",
              "CAMERA_CAPTURE",
              "CAMERA_POWER_OFF",
              "PAYLOAD_STORE_IMAGE",
              "COMMS_SCHEDULE_DOWNLINK",
              "COMMS_DOWNLINK_TO_STATION",
              "COMMS_CONFIRM_RECEIPT",
              "STORE_ONBOARD_AND_WAIT_NEXT_PASS",
              "REQUEST_CROSSLINK_RELAY",
              "MARK_OPERATOR_REVIEW",
              "REQUEST_MANEUVER_REVIEW"
            ]
          },
          "parameters": { "type": "object", "additionalProperties": true },
          "requires_human_confirmation": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
